# Start the MID-360 driver by default with `docker compose up`.
COMPOSE_PROFILES=livox

# Immutable base-image release used by all driver images.
BASE_IMAGE=ghcr.io/skymule-ai/mullet-ros2-base:v0.1.0

# Local image tags. CI will later publish immutable SHA and release tags.
LIVOX_IMAGE_TAG=local
REALSENSE_IMAGE_TAG=local
VIZ_IMAGE_TAG=local

ROS_DOMAIN_ID=0
