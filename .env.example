# Start the MID-360 driver by default with `docker compose up`.
COMPOSE_PROFILES=livox

# Immutable base-image release used by all driver images.
BASE_IMAGE=ghcr.io/skymule-ai/mullet-ros2-base:v0.2.0

# Local image tags. CI will later publish immutable SHA and release tags.
LIVOX_IMAGE_TAG=local
REALSENSE_IMAGE_TAG=local
VIZ_IMAGE_TAG=local

ROS_DOMAIN_ID=0

# Per-vehicle RealSense topic and TF names. Override these in the deployment
# configuration for each aircraft.
REALSENSE_CAMERA_NAMESPACE=uav0
REALSENSE_CAMERA_NAME=d435i
REALSENSE_TF_PREFIX=uav0/d435i
